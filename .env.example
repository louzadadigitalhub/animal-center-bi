SIMPLES_VET_EMAIL=
SIMPLES_VET_PASSWORD=
SIMPLES_VET_LOGIN_URL=https://app.simples.vet/login/login.php
SIMPLES_VET_FILIAL_USER_ID=306237
TZ=America/Sao_Paulo
PORT=8787
DATA_DIR=/data
SCRAPE_MS=120000
SKIP_SCRAPE=0
FRONTEND_ORIGIN=*
SESSION_SECRET=
COOKIE_SECURE=0

# Painel da diretoria. Sem SUPABASE_URL o servidor recusa /api/snapshot:
# falha fechada, porque o snapshot carrega telefone e endereco de tutor.
SUPABASE_URL=
# Chave publica do projeto (formato novo do Supabase). O servidor entrega ela
# ao navegador em /api/config, em vez de VITE_*, porque o Vite embutiria no
# build e o EasyPanel injeta ambiente so em runtime.
SUPABASE_PUBLISHABLE_KEY=
# Cria conta pelo painel. Fica SO no servidor, nunca no navegador.
SUPABASE_SECRET_KEY=
